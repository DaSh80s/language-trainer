{
  "name": "weekly-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generates Daniel's Notion Weekly Review page: deterministic maths from the Notion API, thin LLM prose layer over free models.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "weekly-review": "./src/index.js"
  },
  "scripts": {
    "discover": "node src/index.js discover",
    "dry-run": "node src/index.js run --dry-run",
    "start": "node src/index.js run",
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js"
  }
}
