# ---- Notion (required) -------------------------------------------------
# Internal integration token from https://www.notion.so/profile/integrations
# IMPORTANT: create it in the PERSONAL "Daniel" workspace, not Rigby, and
# share the Food Log / Notes / All tasks / Weekly journal databases with it.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the pinned API version.
# NOTION_VERSION=2022-06-28

# ---- LLM providers (at least one; tried in order) ----------------------
LLM_PROVIDERS=gemini,groq,cloudflare

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# ---- Calendar feeds for the meetings section (optional) ----------------
# JSON array of published ICS feeds. Omit entirely to skip the meetings
# section rather than emit a wrong one.
# ICS_FEEDS=[{"label":"Work","url":"https://outlook.office365.com/owa/calendar/.../calendar.ics"}]
